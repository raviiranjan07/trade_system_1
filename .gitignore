# Virtual environment
.venv

# Python cache
__pycache__/
_pycache__/
*.pyc
*.pyo
*.egg-info/

# Node modules
node_modules/

# Environment variables (contains secrets)
.env

# Data files (standard MLOps structure)
# Ignore large data files but keep the directories + DVC pointers tracked
data/raw/*
!data/raw/*.dvc
!data/raw/.gitignore
data/features/**/*.parquet
data/features/**/*.csv
data/archive/
data/trades/

# DVC pointer metadata (must be in git)
!data/**/*.dvc
!data/**/.gitignore

# Model artifacts — tracked in git (needed on server)
# models/

# Logs
logs/

# IDE
.idea/
.vscode/
*.swp

# OS files
.DS_Store
Thumbs.db
nul

# MLOps
mlflow.db
experiments/**/runs/
