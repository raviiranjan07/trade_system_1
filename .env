# -----------------------------------------------------------------------------
# Adaptive Horizon Configuration
# -----------------------------------------------------------------------------
# Enable/disable adaptive multi-horizon trading
# When true: System queries multiple horizons and picks the best one per state
# When false: Uses single fixed horizon from config.yaml
ADAPTIVE_HORIZON_ENABLED=false

# Horizons to compare when adaptive mode is enabled (comma-separated)
ADAPTIVE_HORIZONS=3,5,10,15
