# REST API: https://fapi.binance.com

# Optional: Override default Futures endpoints
# BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/ws
# BINANCE_FUTURES_REST_URL=https://fapi.binance.com

# API keys (optional - only needed for live trading with real orders)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
